{
    "expo": {
        "name": "Nugget",
        "slug": "nugget",
        "version": "0.1",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "mobile",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/expo.icon",
            "bundleIdentifier": "com.anonymous.nugget",
            "font": ""
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.anonymous.nugget"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 76
                }
            ],
            [
                "expo-font",
                {
                    "fonts": [
                        "./assets/fonts/bricolage-grotesque/BricolageGrotesque-Bold.ttf",
                        "./assets/fonts/bricolage-grotesque/BricolageGrotesque-ExtraBold.ttf",
                        "./assets/fonts/bricolage-grotesque/BricolageGrotesque-ExtraLight.ttf",
                        "./assets/fonts/bricolage-grotesque/BricolageGrotesque-Light.ttf",
                        "./assets/fonts/bricolage-grotesque/BricolageGrotesque-Medium.ttf",
                        "./assets/fonts/bricolage-grotesque/BricolageGrotesque-Regular.ttf",
                        "./assets/fonts/bricolage-grotesque/BricolageGrotesque-SemiBold.ttf",
                        "./assets/fonts/figtree/Figtree-Black.ttf",
                        "./assets/fonts/figtree/Figtree-Bold.ttf",
                        "./assets/fonts/figtree/Figtree-ExtraBold.ttf",
                        "./assets/fonts/figtree/Figtree-Light.ttf",
                        "./assets/fonts/figtree/Figtree-Medium.ttf",
                        "./assets/fonts/figtree/Figtree-Regular.ttf",
                        "./assets/fonts/figtree/figtree/Figtree-SemiBold.ttf",
                        "./assets/fonts/figtree/Figtree-BlackItalic.ttf",
                        "./assets/fonts/figtree/Figtree-BoldItalic.ttf",
                        "./assets/fonts/figtree/Figtree-ExtraBoldItalic.ttf",
                        "./assets/fonts/figtree/Figtree-LightItalic.ttf",
                        "./assets/fonts/figtree/Figtree-MediumItalic.ttf",
                        "./assets/fonts/figtree/Figtree-RegularItalic.ttf",
                        "./assets/fonts/figtree/Figtree-SemiBoldItalic.ttf"
                    ]
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
